{
  "name": "remotion-lambda-cdk",
  "version": "0.1.0",
  "description": "AWS CDK construct library for deploying Remotion Lambda rendering infrastructure",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest --runInBand",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf lib"
  },
  "keywords": [
    "aws",
    "cdk",
    "remotion",
    "lambda",
    "video",
    "rendering"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@remotion/lambda": "^4.0.502",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "aws-cdk-lib": "^2.150.0",
    "constructs": "^10.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "@remotion/lambda": "^4.0.0",
    "aws-cdk-lib": "^2.150.0",
    "constructs": "^10.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    }
  }
}
